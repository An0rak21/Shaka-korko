# KORKO — identifiants SMS. Copie ce fichier en « sms.env » et remplis UN fournisseur.
# Ne partage jamais ce fichier (ni dans un chat, ni sur une clé) : il contient tes clés.

# Nom qui s'affiche comme expéditeur (11 caractères max, lettres et chiffres)
SMS_EXPEDITEUR=KORKO

# --- Option 1 : Brevo (français, crédits SMS prépayés) ---
# Clé : app.brevo.com > Paramètres > Clés API (SMTP & API)
BREVO_API_KEY=

# --- Option 2 : Twilio (essai gratuit, envoi vers tes numéros vérifiés) ---
# console.twilio.com > Account Info
TWILIO_SID=
TWILIO_TOKEN=
# en essai gratuit : ton numéro Twilio (+1…) obligatoire. Compte payant : peut rester vide (envoi au nom de KORKO)
TWILIO_FROM=

# --- Option 3 : Infobip (essai gratuit, envoi vers ton numéro vérifié) ---
# portal.infobip.com > page d'accueil : « Base URL » et clé API
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
